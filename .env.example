# ------------------------------------------------------------------
# Where quote + review emails are sent FROM.
# The sender tries Resend first, then falls back to Gmail SMTP.
# Set up EITHER one (Resend recommended).
# ------------------------------------------------------------------

# --- 1. Resend (recommended) -------------------------------------
# Create a key: resend.com -> Sign up -> API Keys -> Create API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Sign up with riteprocleaningservices@gmail.com as the account email.
# With that, Resend's default sender already delivers to that inbox and
# you do NOT need to verify a domain or touch DNS. Leave RESEND_FROM
# unset to use this.
#
# Only once you have verified riteprocleaning.com.au in Resend
# (Domains -> Add Domain) should you uncomment the line below, to get
# a branded sender instead of onboarding@resend.dev:
# RESEND_FROM="Ritepro Cleaning <website@riteprocleaning.com.au>"

# --- 2. Gmail SMTP fallback (optional) --------------------------
# Needs 2-Step Verification on, then generate an App Password at
# https://myaccount.google.com/apppasswords
# Current value in .env.local is REJECTED by Google (535) and must be
# replaced if you rely on this path.
GMAIL_USER="riteprocleaningservices@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# --- 3. Only if you use a different SMTP provider ---------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"